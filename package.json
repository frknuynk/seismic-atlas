{
  "name": "seismic-atlas",
  "version": "0.8.0-alpha.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:worker": "vitest run --project worker",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:smoke": "npm run build && playwright test --grep @smoke",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle:check && playwright test --project=chromium",
    "lint": "oxlint",
    "format": "oxfmt",
    "bundle:check": "node scripts/check_bundle_budget.mjs",
    "data:build:faults": "node scripts/build_fault_layer.mjs",
    "sync:usgs:local": "node --import tsx scripts/sync_afad_local.ts --source=USGS",
    "sync:usgs:scheduled:local": "node --import tsx scripts/sync_afad_local.ts --source=USGS --trigger=scheduled",
    "sync:afad:local": "node --import tsx scripts/sync_afad_local.ts --source=AFAD",
    "sync:afad:scheduled:local": "node --import tsx scripts/sync_afad_local.ts --source=AFAD --trigger=scheduled",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply seismic-atlas-local --local --config wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "hono": "4.13.14",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.16.0",
    "pmtiles": "^4.5.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "fflate": "0.8.3"
  },
  "type": "module"
}
